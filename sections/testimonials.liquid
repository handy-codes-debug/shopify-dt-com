{% comment %}
  “What builders say”: review quotes. Add a reviews-app block to show live
  reviews instead of (or alongside) the manual quotes.
{% endcomment %}

<section class="dt-band">
  <div class="dt-container dt-band__inner">
    <div class="dt-section-head">
      <div>
        <h2 class="dt-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.summary != blank -%}
          <p class="dt-section-head__sub">
            <span class="dt-stars" aria-hidden="true">★★★★★</span>
            {{ section.settings.summary | escape }}
          </p>
        {%- endif -%}
      </div>
    </div>

    <div class="dt-quote-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="dt-quote-grid__app">{% render block %}</div>
          {%- when 'quote' -%}
            <figure class="dt-quote" {{ block.shopify_attributes }}>
              {%- render 'stars', rating: block.settings.rating -%}
              <blockquote>{{ block.settings.quote | escape }}</blockquote>
              <figcaption>{{ block.settings.author | escape }}</figcaption>
            </figure>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What builders say"
    },
    {
      "type": "text",
      "id": "summary",
      "label": "Rating summary",
      "default": "4.8 average from verified reviews"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Fast shipping and the card arrived perfectly packed."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author line",
          "default": "Customer name · Verified buyer · Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "DealTargets",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Review text from a verified buyer — ideally one that mentions speed of shipping or packaging." } },
        { "type": "quote", "settings": { "quote": "Review text that mentions the compatibility check or support experience." } },
        { "type": "quote", "settings": { "quote": "Review text that mentions pricing, deals or returns." } }
      ]
    }
  ]
}
{% endschema %}
