{% comment %}
  Generic content page (About, Contact, Help, etc.).
{% endcomment %}

<div class="dt-container dt-page-pad">
  <nav class="dt-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ page.title | escape }}</span>
  </nav>

  <article class="dt-panel dt-page-article">
    <h1 class="dt-h1">{{ page.title | escape }}</h1>
    <div class="dt-rte">{{ page.content }}</div>
  </article>
</div>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
