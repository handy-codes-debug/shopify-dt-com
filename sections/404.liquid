{% comment %}
  404 page.
{% endcomment %}

<div class="dt-container dt-page-pad">
  <div class="dt-panel dt-notfound">
    {%- render 'icon', name: 'search', size: 56, stroke: 1.4 -%}
    <p class="dt-eyebrow">Error 404</p>
    <h1 class="dt-h1">That part isn’t in stock — or anywhere.</h1>
    <p class="dt-muted">The page you’re looking for doesn’t exist. Try a search, or head back to the shop.</p>
    <div class="dt-notfound__search">
      {%- render 'search-form', id_prefix: 'nf', compact: true -%}
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="dt-btn dt-btn--accent dt-btn--lg">Back to shopping</a>
  </div>
</div>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
