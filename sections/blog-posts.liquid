{% comment %}
  “Guides & news”: latest articles from a blog.
{% endcomment %}

{%- assign b = section.settings.blog | default: blogs.news -%}

{%- if b.articles_count > 0 or request.design_mode -%}
  <section class="dt-section dt-section--bottom">
    <div class="dt-container">
      <div class="dt-section-head">
        <h2 class="dt-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.link_label != blank and b.url != blank -%}
          <a href="{{ b.url }}" class="dt-link-arrow">{{ section.settings.link_label | escape }} →</a>
        {%- endif -%}
      </div>

      <div class="dt-article-grid">
        {%- for article in b.articles limit: section.settings.count -%}
          {%- render 'article-card', article: article -%}
        {%- else -%}
          <p class="dt-empty">Choose a blog with published articles to fill this section.</p>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Blog posts",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Guides & news"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Defaults to the News blog."
    },
    {
      "type": "range",
      "id": "count",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Articles to show",
      "default": 3
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All articles"
    }
  ],
  "presets": [
    {
      "name": "Blog posts",
      "category": "DealTargets"
    }
  ]
}
{% endschema %}
