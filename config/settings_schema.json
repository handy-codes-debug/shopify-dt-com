[
  {
    "name": "theme_info",
    "theme_name": "DealTargets",
    "theme_version": "1.0.0",
    "theme_author": "DealTargets",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons, highlights)",
        "default": "#FF6B1A"
      },
      {
        "type": "color",
        "id": "color_accent_strong",
        "label": "Accent – links",
        "default": "#E8590C"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Accent – text and sale prices",
        "default": "#C2410C"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (text and dark surfaces)",
        "default": "#1F2125"
      },
      {
        "type": "color",
        "id": "color_page",
        "label": "Page background",
        "default": "#F2F2F3"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          { "value": "1360px", "label": "Standard (1360px)" },
          { "value": "1600px", "label": "Wide (1600px)" }
        ],
        "default": "1360px"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 48,
        "step": 2,
        "unit": "px",
        "label": "Page side margin (desktop)",
        "default": 32
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 14,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 8
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "range",
        "id": "low_stock_threshold",
        "min": 1,
        "max": 20,
        "step": 1,
        "label": "Show “Low stock” at or below",
        "default": 5,
        "info": "Only applies to variants that track inventory."
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show star rating on product cards",
        "info": "Uses the standard reviews.rating metafield written by most reviews apps.",
        "default": true
      },
      {
        "type": "text",
        "id": "best_seller_tag",
        "label": "Product tag for “Best seller” badge",
        "default": "best-seller"
      },
      {
        "type": "text",
        "id": "new_tag",
        "label": "Product tag for “New” badge",
        "default": "new"
      }
    ]
  }
]
