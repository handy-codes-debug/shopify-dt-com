{% comment %}
  Article page with optional comments.
{% endcomment %}

<div class="dt-container dt-page-pad">
  <nav class="dt-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ article.title | escape }}</span>
  </nav>

  <article class="dt-panel dt-page-article dt-article">
    {%- if article.tags.size > 0 -%}
      <p class="dt-eyebrow">{{ article.tags.first | escape }}</p>
    {%- endif -%}
    <h1 class="dt-h1">{{ article.title | escape }}</h1>
    {%- assign date = article.published_at | time_tag: format: 'date' -%}
    <p class="dt-muted dt-small">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>

    {%- if article.image -%}
      <div class="dt-article__image">
        {{ article.image | image_url: width: 1600 | image_tag: sizes: '(min-width: 990px) 860px, 100vw', widths: '600, 900, 1200, 1600' }}
      </div>
    {%- endif -%}

    <div class="dt-rte">{{ article.content }}</div>
  </article>

  {%- if blog.comments_enabled? -%}
    <section class="dt-panel dt-page-article dt-comments" id="comments">
      <h2 class="dt-h3">{{ 'blog.article_comments' | t }} ({{ article.comments_count }})</h2>

      {%- paginate article.comments by 10 -%}
        {%- for comment in article.comments -%}
          <div class="dt-comment">
            <p><strong>{{ comment.author | escape }}</strong> · <span class="dt-muted dt-small">{{ comment.created_at | time_tag: format: 'date' }}</span></p>
            <div class="dt-rte">{{ comment.content }}</div>
          </div>
        {%- endfor -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article, class: 'dt-form' -%}
        <h3 class="dt-h3">{{ 'blog.comment_form_title' | t }}</h3>
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}
          <p role="status">Thanks — your comment has been submitted.</p>
        {%- endif -%}
        <div class="dt-form__row">
          <label for="CommentAuthor">{{ 'blog.comment_form_name' | t }}</label>
          <input class="dt-input" type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" required>
        </div>
        <div class="dt-form__row">
          <label for="CommentEmail">{{ 'blog.comment_form_email' | t }}</label>
          <input class="dt-input" type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" required>
        </div>
        <div class="dt-form__row">
          <label for="CommentBody">{{ 'blog.comment_form_body' | t }}</label>
          <textarea class="dt-input dt-textarea" name="comment[body]" id="CommentBody" rows="5" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="dt-btn dt-btn--accent">{{ 'blog.comment_form_submit' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
