{% comment %}
  All collections page (list-collections template).
{% endcomment %}

<div class="dt-container dt-page-pad">
  <nav class="dt-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ section.settings.heading | escape }}</span>
  </nav>

  <div class="dt-page-head">
    <h1 class="dt-h1">{{ section.settings.heading | escape }}</h1>
  </div>

  <div class="dt-category-grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="dt-category-card">
        <div class="dt-category-card__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 800' }}
          {%- else -%}
            {%- render 'icon', guess: collection.title, size: 96, stroke: 1.1 -%}
          {%- endif -%}
        </div>
        <div class="dt-category-card__body">
          <span class="dt-category-card__title">{{ collection.title | escape }}</span>
          {%- if collection.description != blank -%}
            <span class="dt-category-card__blurb">{{ collection.description | strip_html | truncatewords: 15 }}</span>
          {%- endif -%}
          <span class="dt-category-card__cta">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }} →</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All components"
    }
  ],
  "presets": [{ "name": "Collections list", "category": "DealTargets" }]
}
{% endschema %}
