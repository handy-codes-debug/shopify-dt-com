{% comment %}
  DealTargets footer: newsletter signup, brand + social, menu columns (blocks),
  contact details, policies and payment icons.
{% endcomment %}

<footer class="dt-footer">
  {%- if section.settings.show_newsletter -%}
    <div class="dt-footer__newsletter">
      <div class="dt-container dt-footer__newsletter-inner">
        <div class="dt-footer__newsletter-copy">
          <h2 class="dt-footer__newsletter-title">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- if section.settings.newsletter_text != blank -%}
            <p>{{ section.settings.newsletter_text | escape }}</p>
          {%- endif -%}
        </div>
        {%- form 'customer', id: 'FooterNewsletter', class: 'dt-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="FooterNewsletterEmail" class="visually-hidden">Email address</label>
          <input
            id="FooterNewsletterEmail"
            class="dt-footer__email"
            type="email"
            name="contact[email]"
            placeholder="you@example.com"
            autocomplete="email"
            required
          >
          <button type="submit" class="dt-btn dt-btn--accent dt-btn--lg">Subscribe</button>
          {%- if form.posted_successfully? -%}
            <p class="dt-footer__form-msg" role="status">Thanks — you’re on the list.</p>
          {%- elsif form.errors -%}
            <p class="dt-footer__form-msg dt-footer__form-msg--error" role="alert">
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="dt-container dt-footer__columns">
    <div class="dt-footer__brand">
      <a href="{{ routes.root_url }}" class="dt-logo" aria-label="{{ shop.name | escape }} home">
        {%- render 'logo', inverse: true -%}
      </a>
      {%- if section.settings.about_text != blank -%}
        <p>{{ section.settings.about_text | escape }}</p>
      {%- endif -%}
      {%- capture socials -%}
        {%- if section.settings.social_instagram != blank -%}<li><a href="{{ section.settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
        {%- if section.settings.social_youtube != blank -%}<li><a href="{{ section.settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a></li>{%- endif -%}
        {%- if section.settings.social_facebook != blank -%}<li><a href="{{ section.settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a></li>{%- endif -%}
        {%- if section.settings.social_tiktok != blank -%}<li><a href="{{ section.settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
        {%- if section.settings.social_x != blank -%}<li><a href="{{ section.settings.social_x }}" rel="noopener" target="_blank">X</a></li>{%- endif -%}
      {%- endcapture -%}
      {%- if socials != blank -%}
        <ul class="dt-footer__social" aria-label="Social media">{{ socials }}</ul>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.settings.menu.links.size > 0 -%}
        <nav class="dt-footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
          <h3 class="dt-footer__heading">{{ block.settings.heading | escape }}</h3>
          <ul class="dt-footer__links">
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.show_contact -%}
      <div class="dt-footer__col">
        <h3 class="dt-footer__heading">Contact</h3>
        <address class="dt-footer__contact">
          {%- if section.settings.address != blank -%}
            <span>{{ section.settings.address | escape | newline_to_br }}</span>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.phone | escape }}</a>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <span class="dt-footer__muted">{{ section.settings.hours | escape }}</span>
          {%- endif -%}
        </address>
      </div>
    {%- endif -%}
  </div>

  <div class="dt-footer__bottom">
    <div class="dt-container dt-footer__bottom-inner">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.copyright_suffix | escape }}</span>

      {%- if section.settings.show_policies and shop.policies.size > 0 -%}
        <nav class="dt-footer__policies" aria-label="Policies">
          {%- for policy in shop.policies -%}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- if section.settings.show_payment_icons -%}
        <ul class="dt-footer__payments" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'dt-payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "dt-section-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Get restock alerts and deal drops"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Text",
      "default": "One email a week, tops. Unsubscribe any time."
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Computer components for builders, gamers and businesses — shipped fast across the United States."
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X (Twitter) URL"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact column",
      "default": true
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "support@dealtargets.com"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Mon–Fri 9:00–6:00 ET"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Text after copyright",
      "default": "All prices in USD."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
