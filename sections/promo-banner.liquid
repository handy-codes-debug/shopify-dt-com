{% comment %}
  Dark rounded campaign banner (e.g. Black Friday).
{% endcomment %}

<section class="dt-section">
  <div class="dt-container">
    <div class="dt-promo">
      <div class="dt-promo__copy">
        {%- if section.settings.tag != blank -%}
          <span class="dt-promo__tag">{{ section.settings.tag | escape }}</span>
        {%- endif -%}
        <h2 class="dt-promo__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="dt-promo__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      <div class="dt-btn-row">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: '#' }}" class="dt-btn dt-btn--light dt-btn--lg">{{ section.settings.button_1_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: '#' }}" class="dt-btn dt-btn--ghost-dark dt-btn--lg">{{ section.settings.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Black Friday · Starts Nov 27"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Black Friday deals on GPUs, CPUs and full build bundles."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join the early-access list and get the deal drop in your inbox before it goes live."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Preview the deals"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Get early access"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Promo banner",
      "category": "DealTargets"
    }
  ]
}
{% endschema %}
