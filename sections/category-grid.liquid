{% comment %}
  “Shop by category” grid. Each block is a collection card; when the collection
  has no image a component icon is shown on a grey tile.
{% endcomment %}

<section class="dt-section dt-section--top">
  <div class="dt-container">
    <div class="dt-section-head">
      <div>
        <h2 class="dt-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="dt-section-head__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.collections_url }}" class="dt-link-arrow">{{ section.settings.link_label | escape }} →</a>
      {%- endif -%}
    </div>

    <div class="dt-category-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign title = block.settings.title | default: c.title | default: 'Collection'
          assign short = block.settings.short_label | default: title
          assign url = c.url | default: routes.collections_url
          assign blurb = block.settings.blurb
          if blurb == blank and c.description != blank
            assign blurb = c.description | strip_html | truncatewords: 12
          endif
        -%}
        <a href="{{ url }}" class="dt-category-card" {{ block.shopify_attributes }}>
          <div class="dt-category-card__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 800' }}
            {%- elsif c.featured_image -%}
              {{ c.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 800' }}
            {%- else -%}
              {%- render 'icon', name: block.settings.icon, guess: title, size: 96, stroke: 1.1 -%}
            {%- endif -%}
          </div>
          <div class="dt-category-card__body">
            <span class="dt-category-card__title">{{ title | escape }}</span>
            {%- if blurb != blank -%}
              <span class="dt-category-card__blurb">{{ blurb | escape }}</span>
            {%- endif -%}
            <span class="dt-category-card__cta">Shop {{ short | escape }} →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "tag": "div",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Eight core collections — everything you need for a complete build."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection title."
        },
        {
          "type": "text",
          "id": "short_label",
          "label": "Short name for link",
          "info": "e.g. GPUs → “Shop GPUs →”"
        },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Blurb"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "800 × 600. Defaults to the collection image, then an icon."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Placeholder icon",
          "options": [
            { "value": "", "label": "Auto (from title)" },
            { "value": "gpu", "label": "Graphics card" },
            { "value": "cpu", "label": "Processor" },
            { "value": "motherboard", "label": "Motherboard" },
            { "value": "ram", "label": "Memory" },
            { "value": "ssd", "label": "Storage" },
            { "value": "psu", "label": "Power supply" },
            { "value": "case", "label": "Case" },
            { "value": "cooling", "label": "Cooling" },
            { "value": "monitor", "label": "Monitor" },
            { "value": "desktop", "label": "Desktop PC" },
            { "value": "laptop", "label": "Notebook / laptop" },
            { "value": "box", "label": "Box" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "category": "DealTargets",
      "blocks": [
        { "type": "collection", "settings": { "title": "Graphics Cards", "short_label": "GPUs", "blurb": "From 1080p value cards to flagship 4K performance." } },
        { "type": "collection", "settings": { "title": "Processors", "short_label": "CPUs", "blurb": "Intel and AMD desktop CPUs for gaming and work." } },
        { "type": "collection", "settings": { "title": "Motherboards", "short_label": "motherboards", "blurb": "AM5, LGA1851 and more, in ATX, mATX and ITX." } },
        { "type": "collection", "settings": { "title": "Memory", "short_label": "RAM", "blurb": "DDR5 and DDR4 kits, tuned for EXPO and XMP." } }
      ]
    }
  ]
}
{% endschema %}
