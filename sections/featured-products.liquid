{% comment %}
  “Today's top deals”: tabbed product grids. Each block is a tab showing one
  collection (e.g. Best sellers / New arrivals / On sale).
{% endcomment %}

{%- assign limit = section.settings.products_to_show -%}

<section class="dt-section" data-tabs>
  <div class="dt-container">
    <div class="dt-section-head">
      <h2 class="dt-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.blocks.size > 1 -%}
        <div class="dt-segmented" role="tablist" aria-label="Product lists">
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              id="Tab-{{ block.id }}"
              aria-controls="Panel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {% unless forloop.first %}
                tabindex="-1"
              {% endunless %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection | default: collections.all -%}
      <div
        class="dt-product-grid"
        role="tabpanel"
        id="Panel-{{ block.id }}"
        aria-labelledby="Tab-{{ block.id }}"
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        {%- for product in c.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- else -%}
          <p class="dt-empty">Add products to “{{ c.title | default: block.settings.label | escape }}” to fill this tab.</p>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Today's top deals"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products per tab",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Best sellers"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Defaults to all products."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "DealTargets",
      "blocks": [
        { "type": "tab", "settings": { "label": "Best sellers" } },
        { "type": "tab", "settings": { "label": "New arrivals" } },
        { "type": "tab", "settings": { "label": "On sale" } }
      ]
    }
  ]
}
{% endschema %}
