{% comment %}
  “Pair it with”: Shopify product recommendations, loaded asynchronously.
  Use “Complementary” intent with the Search & Discovery app to hand-pick
  matching parts; “Related” works automatically.
{% endcomment %}

<section
  class="dt-container dt-recs"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <h2 class="dt-h2 dt-h2--sm">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="dt-muted dt-recs__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    <div class="dt-product-grid">
      {%- for product in recommendations.products -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair it with"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Parts that match this product's power and size requirements."
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related" },
        { "value": "complementary", "label": "Complementary" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Product recommendations",
      "category": "DealTargets"
    }
  ]
}
{% endschema %}
