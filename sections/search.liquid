{% comment %}
  Search results page using the same filter sidebar and product cards as the
  collection page. Non-product results (articles, pages) get a simple card.
{% endcomment %}

{%- liquid
  assign terms = search.terms | escape
  capture clear_url
    echo routes.search_url
    echo '?q='
    echo search.terms | url_encode
    echo '&options%5Bprefix%5D=last'
  endcapture
-%}

<div class="dt-container dt-page-pad">
  <nav class="dt-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Search</span>
  </nav>

  <div class="dt-page-head">
    <div class="dt-page-head__copy">
      <h1 class="dt-h1">
        {%- if search.performed -%}
          Results for “{{ terms }}”
        {%- else -%}
          Search
        {%- endif -%}
      </h1>
      <div class="dt-search-page__form">
        {%- render 'search-form', id_prefix: 'page', compact: true -%}
      </div>
    </div>
    {%- if search.performed -%}
      <span class="dt-muted dt-small">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }}</span>
    {%- endif -%}
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.per_page -%}
      <div class="dt-results{% if search.filters.size == 0 %} dt-results--no-filters{% endif %}">
        {%- render 'facets-sidebar',
          results: search,
          clear_url: clear_url,
          terms: search.terms,
          sort_by: search.sort_by,
          results_count: search.results_count
        -%}

        <section class="dt-results__main" aria-label="Search results">
          {%- render 'facets-toolbar',
            results: search,
            paginate: paginate,
            sort_by: search.sort_by,
            sort_options: search.sort_options
          -%}

          <div class="dt-product-grid dt-product-grid--results" data-product-grid>
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                {%- render 'product-card', product: result -%}
              {%- else -%}
                <a href="{{ result.url }}" class="dt-panel dt-result-card">
                  <span class="dt-eyebrow">{{ result.object_type | capitalize }}</span>
                  <span class="dt-h3">{{ result.title | escape }}</span>
                  {%- assign excerpt = result.excerpt | default: result.content | strip_html | truncatewords: 24 -%}
                  {%- if excerpt != blank -%}
                    <span class="dt-muted dt-small">{{ excerpt }}</span>
                  {%- endif -%}
                </a>
              {%- endif -%}
            {%- else -%}
              <div class="dt-empty dt-empty--panel">
                <p>No results for “{{ terms }}”. Try a part number, a brand, or fewer words.</p>
                <a href="{{ routes.all_products_collection_url }}" class="dt-btn dt-btn--outline">Browse all products</a>
              </div>
            {%- endfor -%}
          </div>

          {%- render 'pagination', paginate: paginate -%}
        </section>
      </div>
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Results per page",
      "default": 12
    }
  ]
}
{% endschema %}
