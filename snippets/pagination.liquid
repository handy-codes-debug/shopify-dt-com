{%- doc -%}
  Square-button pagination matching the DealTargets design.

  @param {object} paginate - The paginate object from a {% paginate %} block

  @example
  {% render 'pagination', paginate: paginate %}
{%- enddoc -%}

{%- if paginate.pages > 1 -%}
  <nav class="dt-pagination" aria-label="Pagination">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="dt-pagination__item" aria-label="Previous page">‹</a>
    {%- else -%}
      <span class="dt-pagination__item is-disabled" aria-hidden="true">‹</span>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="dt-pagination__item">{{ part.title }}</a>
      {%- elsif part.title contains 'hellip' -%}
        <span class="dt-pagination__item is-gap">{{ part.title }}</span>
      {%- else -%}
        <span class="dt-pagination__item is-current" aria-current="page">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="dt-pagination__item" aria-label="Next page">›</a>
    {%- else -%}
      <span class="dt-pagination__item is-disabled" aria-hidden="true">›</span>
    {%- endif -%}
  </nav>
{%- endif -%}
