{% comment %}
  Blog listing: grid of article cards.
{% endcomment %}

<div class="dt-container dt-page-pad">
  <nav class="dt-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ blog.title | escape }}</span>
  </nav>

  <div class="dt-page-head">
    <h1 class="dt-h1">{{ blog.title | escape }}</h1>
  </div>

  {%- if blog.all_tags.size > 0 -%}
    <ul class="dt-pills" aria-label="Topics">
      <li><a href="{{ blog.url }}" class="dt-pill{% if current_tags == blank %} is-active{% endif %}">All</a></li>
      {%- for tag in blog.all_tags -%}
        <li>
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="dt-pill{% if current_tags contains tag %} is-active{% endif %}">{{ tag | escape }}</a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- paginate blog.articles by 9 -%}
    <div class="dt-article-grid">
      {%- for article in blog.articles -%}
        {%- render 'article-card', article: article -%}
      {%- else -%}
        <p class="dt-empty">No articles yet.</p>
      {%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
