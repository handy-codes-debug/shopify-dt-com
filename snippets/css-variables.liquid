{% style %}
  :root {
    --page-width: {{ settings.max_page_width | default: '1360px' }};
    --page-margin: {{ settings.min_page_margin | default: 32 }}px;
    --color-background: {{ settings.color_page | default: '#F2F2F3' }};
    --color-foreground: {{ settings.color_ink | default: '#1F2125' }};
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 8 }}px;

    --dt-ink: {{ settings.color_ink | default: '#1F2125' }};
    --dt-page: {{ settings.color_page | default: '#F2F2F3' }};
    --dt-accent: {{ settings.color_accent | default: '#FF6B1A' }};
    --dt-accent-strong: {{ settings.color_accent_strong | default: '#E8590C' }};
    --dt-accent-text: {{ settings.color_accent_text | default: '#C2410C' }};
  }
{% endstyle %}
