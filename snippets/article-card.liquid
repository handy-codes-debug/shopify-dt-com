{%- doc -%}
  Article card: image, first tag (as category label) and title.

  @param {article} article - The article

  @example
  {% render 'article-card', article: article %}
{%- enddoc -%}

<a href="{{ article.url }}" class="dt-article-card">
  <div class="dt-article-card__media">
    {%- if article.image -%}
      {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 800' }}
    {%- else -%}
      {%- render 'icon', name: 'book', size: 56, stroke: 1.2 -%}
    {%- endif -%}
  </div>
  <span class="dt-eyebrow">{{ article.tags.first | default: article.blog.title | default: 'Article' | escape }}</span>
  <span class="dt-article-card__title">{{ article.title | escape }}</span>
</a>
