{% comment %}
  Password (coming soon) page.
{% endcomment %}

<div class="dt-password">
  <div class="dt-password__card">
    <span class="dt-logo">{% render 'logo' %}</span>
    <h1 class="dt-h2">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="dt-muted">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'dt-password__form' -%}
      {%- if form.errors -%}
        {{ form.errors | default_errors }}
      {%- endif -%}
      <label for="password-input" class="visually-hidden">{{ 'password.password' | t }}</label>
      <input class="dt-input" type="password" name="password" id="password-input" placeholder="{{ 'password.password' | t }}" required>
      <button type="submit" class="dt-btn dt-btn--accent dt-btn--lg">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
